{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebFit Emissor de Licenças",
  "version": "0.1.1",
  "identifier": "br.com.webfit.licenseissuer",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run issuer:dev",
    "beforeBuildCommand": "npm --prefix ../.. run issuer:build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WebFit — Emissor de licenças",
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["../../../src-tauri/icons/icon.ico"] }
}
